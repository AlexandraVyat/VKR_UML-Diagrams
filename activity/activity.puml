@startuml

skinparam shadowing false
skinparam activity {
    BackgroundColor #EAF2F8
    BorderColor #527A9E
    DiamondBackgroundColor #F5F7FA
    DiamondBorderColor #527A9E
    ArrowColor #526B82
    FontColor #263746
}

start

:Открыть список назначенных заданий;
:Выбрать задание;
:Отобразить упражнения задания;

while (Остались упражнения?) is (Да)
    :Ввести числовой ответ;
    :Отправить ответ;
    :Проверить правильность ответа;

    if (Ответ правильный?) then (Да)
        :Увеличить счётчик правильных ответов;
    endif

    :Сохранить ответ ученика;

endwhile (Нет)

:Рассчитать итоговый процент;
:Определить текущий уровень сложности;

if (Результат от 80%?) then (Да)
    :Повысить уровень сложности;
else (Нет)
    if (Результат ниже 50%?) then (Да)
        :Понизить уровень сложности;
    else (Нет)
        :Сохранить текущий уровень;
    endif
endif

:Сохранить результат выполнения;
:Показать результат ученику;

stop

@enduml
